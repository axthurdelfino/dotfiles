{
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "session": {
    "trust_all_worktrees": true
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Soft Charmed Icons"
  },
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Ayu Dark"
  },
  "file_scan_exclusions": [
    "**/*.class"
  ],
  "auto_install_extensions": {
    "java": true
  },
  "languages": {
    "Java": {
      "language_servers": [
        "jdtls"
      ],
      "formatter": "language_server"
    }
  }
}
